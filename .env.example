# Copiare in .env e riempire. compose lo legge automaticamente.

# --- Profilo OpenRouter (default) ---
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-...
OPENAI_CHAT_COMPLETION_MODEL=anthropic/claude-sonnet-5

# --- Profilo LM Studio (LLM sull'host Windows) ---
# Dentro un container "localhost" e' il container stesso: serve host.docker.internal.
# LM Studio deve avere attivo "Serve on Local Network", altrimenti ascolta solo
# su 127.0.0.1 dell'host e nessun container lo raggiunge.
# L'id del modello deve combaciare con quello di GET http://localhost:1234/v1/models
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_API_KEY=lm-studio
# OPENAI_CHAT_COMPLETION_MODEL=<id-esatto-dal-endpoint-models>

# true = nessuna chiamata LLM, usa il fake client (nessun tool, solo chat)
DEMO_FAKE_CLIENT=false

# Origini CORS separate da virgola. Vuoto = localhost e 127.0.0.1 su 3000 e 3001.
# DEMO_ALLOWED_ORIGINS=http://localhost:3000
