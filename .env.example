# Copiare in .env e riempire. compose lo legge automaticamente.

# --- Profilo OpenRouter (default) ---
# Serve un modello con tool-calling reale, altrimenti il tool ui_table non
# viene mai chiamato e il pannello "Stato condiviso" resta vuoto.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-...
OPENAI_CHAT_COMPLETION_MODEL=qwen/qwen3.8-27b
# Alternative con tool-calling, piu' economiche:
#   qwen/qwen3.8-flash               in $0.15/M   out $0.47/M
#   qwen/qwen3-30b-a3b-instruct-2507 in $0.048/M  out $0.19/M
# (qwen/qwen3.8-27b: in $0.42/M, out $3.00/M)

# --- Profilo LM Studio (LLM sull'host Windows) ---
# Dentro un container "localhost" e' il container stesso: serve host.docker.internal.
# Di default LM Studio ascolta solo su 127.0.0.1 e nessun container lo raggiunge.
# Riavviare il server con bind su tutte le interfacce:
#   lms server start --port 1234 --bind 0.0.0.0 --cors
# (equivale a "Serve on Local Network" nella GUI; autorizzare il firewall Windows)
# L'id del modello deve combaciare con quello di GET http://localhost:1234/v1/models
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_API_KEY=lm-studio
# OPENAI_CHAT_COMPLETION_MODEL=google/gemma-4-12b

# true = nessuna chiamata LLM, usa il fake client (nessun tool, solo chat)
DEMO_FAKE_CLIENT=false

# Origini CORS separate da virgola. Vuoto = localhost e 127.0.0.1 su 3000 e 3001.
# DEMO_ALLOWED_ORIGINS=http://localhost:3000

# --- MongoDB (persistenza della memoria conversazionale) ---
# Valori fittizi: sostituirli nel proprio .env, che non e' versionato.
# Sono letti solo al PRIMO avvio, quando il volume mongo-data e' vuoto:
# cambiarli dopo non riscrive l'utente gia' creato dentro il volume.
MONGO_INITDB_ROOT_USERNAME=demo-root
MONGO_INITDB_ROOT_PASSWORD=cambiami-password-locale
MONGO_INITDB_DATABASE=demo_memory
# Porta sull'host. Da cambiare (es. 27018) se sulla macchina gira gia' un
# mongod nativo sulla 27017: Docker non puo' condividere la porta e il
# servizio fallirebbe l'avvio con "address already in use".
MONGO_HOST_PORT=27017

# --- Redis (memoria a breve termine del servizio di memoria) ---
# Valore fittizio: sostituirlo nel proprio .env, non versionato.
REDIS_PASSWORD=cambiami-password-locale
# Porta sull'host. Da cambiare se la 6379 e' gia' occupata.
REDIS_HOST_PORT=6379

# Modello usato per riassumere i turni vecchi. Vuoto = usa quello dell agente.
MEMORY_SUMMARY_MODEL=
