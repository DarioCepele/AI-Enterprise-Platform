# Il modello. Qualunque endpoint compatibile OpenAI.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-...
OPENAI_CHAT_COMPLETION_MODEL=qwen/qwen3.8-27b
# Un modello diverso per un sottoagente, se serve. Vuoto = quello qui sopra.
KNOWLEDGE_MODEL=
ANALYSIS_MODEL=
# Risposte finte, senza chiamare nessun modello: serve ai test e alle demo.
DEMO_FAKE_CLIENT=false

# Quali sottoagenti esistono lo dice il compose (DEMO_SUBAGENTS), che li
# costruisce dai due servizi: qui bastano i loro token, piu' sotto.
# Quanto il master aspetta un sottoagente prima di lasciarlo finire in sfondo.
DEMO_SUBAGENT_WAIT_SECONDS=60
# Firma delle notifiche push. La usano il master e il servizio dei processi.
DEMO_PUSH_SECRET=cambiami-segreto-locale
# I token che sbloccano le card estese dei due sottoagenti.
KNOWLEDGE_SERVICE_TOKEN=cambiami-token-di-servizio
ANALYSIS_SERVICE_TOKEN=cambiami-anche-questo

# Postgres, l'unico database del laboratorio. Tre database sullo stesso server
# -- `processi`, `memoria`, `agente` -- creati alla prima inizializzazione del
# volume dagli script in postgres/init.
POSTGRES_USER=processi
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=processi
POSTGRES_HOST_PORT=5432
PROCESS_HOST_PORT=8300

# Modelli della memoria. Vuoti: niente riassunti, niente ricerca semantica.
MEMORY_SUMMARY_MODEL=
MEMORY_EMBEDDING_MODEL=openai/text-embedding-3-small
# Giorni oltre i quali un thread inattivo viene dimenticato. 0 = mai.
MEMORY_RETENTION_DAYS=0

# Nome del prodotto nell'interfaccia, e dove il frontend trova agente e processi.
PRODUCT_NAME=AG-UI Lab
AGUI_URL=
PROCESS_URL=
DEMO_ALLOWED_ORIGINS=

# Log strutturati in JSON per un collettore; a mano si legge meglio la riga piana.
JSON_LOGS=false
# Con un collector OTLP le tracce attraversano i servizi; senza, non si esporta.
OTEL_EXPORTER_OTLP_ENDPOINT=
