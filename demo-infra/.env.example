# Copy to .env and fill in. Every secret below must be replaced: generate each
# one with `openssl rand -hex 24` (hex keeps it safe inside a database URL).

# --- The model. Any OpenAI-compatible endpoint. ---------------------------------
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_CHAT_COMPLETION_MODEL=qwen/qwen3.8-27b
# A different model for a subagent, if needed. Empty: the one above.
KNOWLEDGE_MODEL=
ANALYSIS_MODEL=
# The vision model analyze_video uses (must accept images; video natively if it can).
VISION_MODEL=qwen/qwen3.8-27b
# Fixed answers without a model, for every agent: to look around without a
# credential, and for CI. Memory summaries still call the model above, after
# the reply and outside the request: without one they fail in the log only.
FAKE_MODEL=false

# --- The product. ----------------------------------------------------------------
PRODUCT_NAME=Agent Platform
# Language of the answers and of the summaries. Empty: the user's language.
PRODUCT_LANGUAGE=
# `lang` of the web page.
PRODUCT_LOCALE=en

# --- Secrets between services. ---------------------------------------------------
# Signs push notification tokens (master agent and process service).
PUSH_SECRET=
# Unlock the extended cards of the two subagents.
KNOWLEDGE_SERVICE_TOKEN=
ANALYSIS_SERVICE_TOKEN=

# --- Postgres, the only database. -----------------------------------------------
# The superuser: used by the provisioning job and nothing else.
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=
# One role per service, each owning its own database (master, memory,
# processes, agents), created by `postgres-init` on every `up`.
MASTER_DB_PASSWORD=
MEMORY_DB_PASSWORD=
PROCESS_DB_PASSWORD=
AGENTS_DB_PASSWORD=
POSTGRES_HOST_PORT=5432
# Reuse a volume created under another project name, e.g. demo-infra_postgres-data.
POSTGRES_VOLUME=

# --- Memory. -------------------------------------------------------------------
# Summaries and durable facts. Empty: the chat model above.
MEMORY_SUMMARY_MODEL=
# Semantic search over past conversations. Empty: no semantic search.
MEMORY_EMBEDDING_MODEL=openai/text-embedding-3-small
# Days after which an idle thread is forgotten, with the facts it taught. 0 = never.
MEMORY_RETENTION_DAYS=0

# --- Behaviour of the agent. -----------------------------------------------------
# How long a turn waits for a subagent before the answer arrives by notification.
SUBAGENT_WAIT_SECONDS=60
# Tools that stop for a person's approval before they run, comma-separated.
TOOLS_REQUIRING_APPROVAL=start_process

# --- Voice. --------------------------------------------------------------------
# faster-whisper model size, and the language of the speech (empty: detected).
VOICE_STT_MODEL=small
VOICE_STT_LANGUAGE=
# Kokoro voice: a/af_heart for English; i/if_sara for Italian, e/ef_dora for Spanish...
VOICE_TTS_LANG_CODE=a
VOICE_TTS_VOICE=af_heart

# --- Network. ------------------------------------------------------------------
# Where published ports listen. 127.0.0.1: this machine only. 0.0.0.0 exposes the
# platform to the network -- it has no authentication of its own.
BIND_ADDRESS=127.0.0.1
PROCESS_HOST_PORT=8300
VOICE_HOST_PORT=8500
# Addresses the browser uses. Empty: localhost defaults.
AGUI_URL=
PROCESS_URL=
VOICE_URL=
MASTER_ALLOWED_ORIGINS=
PROCESS_ALLOWED_ORIGINS=
VOICE_ALLOWED_ORIGINS=

# --- Operations. -----------------------------------------------------------------
# Structured JSON logs for a collector; the readable line otherwise.
JSON_LOGS=false
# The LOG tab of the interface. Turn off where logs go to a collector.
LOGS_ENDPOINT=true
# With an OTLP collector, traces and metrics cross the services; without, nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
